# Database connection. With docker compose the host is "postgres", e.g.
# postgres://eccsa:YOUR_DB_PASSWORD@postgres:5432/eccsa
DATABASE_URL=postgres://eccsa:YOUR_DB_PASSWORD@127.0.0.1:5432/eccsa
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# Long random string used to secure admin logins (e.g. run: openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public address of the website (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://ethiopianchamber.com

# First administrator created by "pnpm seed"
SEED_ADMIN_EMAIL=admin@ethiopianchamber.com
SEED_ADMIN_PASSWORD=choose-a-strong-password
